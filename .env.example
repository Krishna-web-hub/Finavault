# --- LLM API Configuration ---
# Option 1: Hugging Face Router Inference API
LLM_BASE_URL=https://router.huggingface.co/v1
# FINVAULT_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# Option 2: OpenRouter API
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# FINVAULT_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Option 3: Kimi / Moonshot API
# KIMI_API_KEY=

FINVAULT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
FINVAULT_MAX_TOKENS=4096


# --- Storage (local dev defaults — match docker-compose.yml) ---
# Non-default ports: this host may already run another project's Qdrant/Postgres
# on the standard ports (6333/5432). Dedicated ports keep FinVault's data plane
# isolated rather than sharing infra across projects.
QDRANT_URL=http://localhost:6350
QDRANT_COLLECTION=finvault_chunks

POSTGRES_DSN=postgresql://finvault:finvault_dev_only@localhost:5433/finvault

# --- Security ---
# Path to the local master key (KEK) file. Generated automatically on first run
# if it doesn't exist. In production, swap LocalKeyProvider for a KMS/Vault-backed
# KeyProvider implementing the same interface (security/encryption.py) — nothing
# else in the codebase needs to change.
FINVAULT_MASTER_KEY_PATH=.secrets/master.key

# Symmetric secret used to sign JWTs issued by the API. Generate a strong random
# value for any non-local deployment: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
FINVAULT_JWT_SECRET=dev-only-change-me

# --- Embeddings ---
# Runs fully locally by default (sentence-transformers) — no document content is
# ever sent to a third-party embedding API.
FINVAULT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Optional: Hugging Face User Access Token for private or gated models/embeddings
HF_TOKEN=

# --- Externalization policy ---
# Data classification tiers that are allowed to be sent to the LLM at all.
# "restricted" is deliberately excluded by default — see security/access_control.py
FINVAULT_ALLOWED_EXTERNAL_CLASSIFICATIONS=public,internal,confidential

# --- Observability (see src/finvault/observability.py) ---
# Every log line is one JSON object, carrying the request_id that also comes
# back to the caller in the X-Request-ID header and in every error body — so a
# user reporting an error hands you the exact key to find their request. Set to
# "text" for readable console output while developing.
FINVAULT_LOG_FORMAT=json

# DEBUG is safe to run: no log call site in this codebase writes document
# plaintext, decrypted content, or credentials.
FINVAULT_LOG_LEVEL=INFO

# --- Redis cache (see src/finvault/cache.py) ---
# Empty means no Redis: the process falls back to an in-memory cache, which is
# correct but per-replica — so a multi-replica deployment gets a lower hit rate
# AND a rate limit that is effectively (limit x replica count), since the
# counters stop being shared. Never a hard dependency: an unreachable Redis
# degrades performance, never availability.
FINVAULT_REDIS_URL=redis://localhost:6379/0
FINVAULT_REDIS_TIMEOUT_SECONDS=0.25

# Cached answers for POST /query. Short by design — the corpus-generation
# counter already retires an org's answers the moment anything is ingested, so
# this only bounds staleness from changes that counter cannot see.
FINVAULT_ENABLE_QUERY_CACHE=true
FINVAULT_QUERY_CACHE_TTL_SECONDS=300

# Embeddings are a pure function of (model, text), so they cache for far longer.
FINVAULT_ENABLE_EMBEDDING_CACHE=true
FINVAULT_EMBEDDING_CACHE_TTL_SECONDS=604800

# --- Rate limiting (see src/finvault/api/rate_limit.py) ---
# One /query fans out into several LLM calls, so this protects provider spend
# and upstream quota, not just CPU.
FINVAULT_ENABLE_RATE_LIMIT=true
FINVAULT_RATE_LIMIT_PER_MINUTE=20
FINVAULT_RATE_LIMIT_PER_HOUR=200
FINVAULT_RATE_LIMIT_ANONYMOUS_PER_MINUTE=10

# --- Metrics (see src/finvault/metrics.py) ---
# GET /metrics is unauthenticated by design and exposes counters and latencies,
# never document content or identity. Restrict it at the network layer.
FINVAULT_ENABLE_METRICS=true

# Per-million-token rates for the configured model, used to turn token counters
# into a spend metric. Zero renders a flat cost panel — the honest signal for
# "not configured", which beats a guessed rate on a cost dashboard.
FINVAULT_PRICE_INPUT_PER_MILLION=0.0
FINVAULT_PRICE_OUTPUT_PER_MILLION=0.0

# --- Row Level Security (see src/finvault/security/rls.py) ---
# Tenant isolation enforced by Postgres rather than by every WHERE clause.
# Off by default because enabling it changes what queries return: any code path
# that reads a tenant table without an org in context sees zero rows.
#
# Two things must be true for it to actually enforce anything, and both fail
# silently if they are not:
#   1. Connect as a NON-SUPERUSER role without BYPASSRLS. The `finvault`
#      account created by POSTGRES_USER is a superuser and ignores every
#      policy. Use `finvault_app` (deploy/postgres/01-app-role.sql).
#   2. That role must not own the tables, so schema creation belongs to a
#      separate migration run as the owner — hence FINVAULT_AUTO_CREATE_SCHEMA.
FINVAULT_ENABLE_RLS=false
FINVAULT_AUTO_CREATE_SCHEMA=true

# To run locally WITH row-level security, swap the DSN above for the app role
# and set the two flags accordingly:
#   POSTGRES_DSN=postgresql://finvault_app:finvault_app_dev_only@localhost:5433/finvault
#   FINVAULT_ENABLE_RLS=true
#   FINVAULT_AUTO_CREATE_SCHEMA=false
