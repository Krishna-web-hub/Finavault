# --- LLM API Configuration ---
# FINVAULT_LLM_ROUTE pins which upstream is used: openrouter | moonshot | auto.
# Set it explicitly. "auto" infers the route from whichever key is non-empty,
# which means pasting a second provider's key silently redirects every LLM
# call — and because each route names models differently, FINVAULT_MODEL then
# no longer matches the route it reaches.
#
# **FINVAULT_MODEL must always agree with FINVAULT_LLM_ROUTE.**
#
# Whichever model you choose, verify it actually honors tool forcing before
# trusting it. The Orchestrator relies on `tool_choice` to guarantee
# search_documents runs before any answer is composed; several providers
# accept the parameter and ignore it, with no error — an ungrounded,
# zero-citation answer is the symptom. base.py runs the tool itself when this
# happens (watch finvault_forced_tool_synthesized_total), so a bad model
# degrades search quality rather than grounding, but the right fix is a model
# that honors forcing.
#
# Probe table, measured 2026-09-01 against real requests — not read off
# OpenRouter's advertised `supported_parameters`, which claims tool_choice
# support for models whose upstream provider ignores it:
#
#   minimax/minimax-m2.7:free (openrouter)  honors "required" · free  <- default
#   moonshotai/kimi-k2.5      (openrouter)  honors "required" · PAID
#   moonshotai/kimi-k3        (openrouter)  honors "required" · PAID
#   kimi-k3                   (moonshot)    honors "required" · verified
#                                           end-to-end 2026-09-01. Thinking
#                                           model: set
#                                           FINVAULT_MAX_TOKENS_PER_REQUEST
#                                           to 80000 (a run spent ~48k) and
#                                           keep the compliance review
#                                           ceiling below at its default —
#                                           200 truncates the reviewer
#                                           mid-thought and blocks good
#                                           answers
#   kimi-k2.6                 (moonshot)    400s on any tool_choice
#                                           ("incompatible with thinking enabled")
#   kimi-k2.7-code            (moonshot)    same 400 as k2.6
#   kimi-k2.7-code-highspeed  (moonshot)    same 400 as k2.6
#   qwen/qwen-2.5-72b-instruct              ignores every form, silently — do
#                                           not use; this is the failure the
#                                           forced-tool fallback exists for
#
# The paid slugs 402 outright on an OpenRouter account with zero credits, so
# the default below is a free model verified to honor forcing: the grounding
# guarantee holds at no cost.

# Option 1: OpenRouter (recommended — broadest model choice, highest limits)
FINVAULT_LLM_ROUTE=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FINVAULT_MODEL=minimax/minimax-m2.7:free

# Option 2: Kimi / Moonshot direct. Bare model slugs, no "moonshotai/" prefix.
# Check your org's RPM allowance first: one query makes ~5-8 sequential LLM
# calls, so a low per-minute cap (the free tier is 3 RPM) 429s mid-question.
# base.py retries a 429 patiently (5 attempts, 4s→30s backoff) precisely
# because of this, but retries cannot manufacture quota you do not have.
# FINVAULT_LLM_ROUTE=moonshot
# KIMI_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# FINVAULT_MODEL=kimi-k3
#
# --- Optional Per-Agent Model Specialization ---
# You can assign specialized models to specific agents (falls back to FINVAULT_MODEL if omitted):
# FINVAULT_ORCHESTRATOR_MODEL=kimi-k3
# FINVAULT_ANALYST_MODEL=kimi-k3
# FINVAULT_RETRIEVER_MODEL=kimi-k2.7-code-highspeed
# FINVAULT_COMPLIANCE_MODEL=kimi-k2.7-code-highspeed

# Option 3: Hugging Face Router Inference API
# LLM_BASE_URL=https://router.huggingface.co/v1
# FINVAULT_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# Per-request HTTP timeout for LLM calls, in seconds. This is a property of the
# model you picked, not of FinVault: a model that thinks before answering
# routinely exceeds the old hardcoded 60s, turning a slow-but-working model
# into a stream of timeouts. Raise it for reasoning models.
FINVAULT_LLM_TIMEOUT_SECONDS=180

# Ceiling on ComplianceAgent's semantic-review call. Only raise-worthy for
# reasoning models: they spend the budget thinking and get truncated before
# emitting the verdict word, which fails closed and blocks a correct answer.
# Costs nothing on a model that answers directly — this caps generation, it
# does not reserve spend.
FINVAULT_COMPLIANCE_REVIEW_MAX_TOKENS=2048

# Ceiling on total tokens for one end-to-end /query (the whole agent chain).
# A thinking model needs materially more: kimi-k3 spent ~48k on a single
# question against the 40000 default and died mid-chain.
# FINVAULT_MAX_TOKENS_PER_REQUEST=80000

FINVAULT_MAX_TOKENS=4096


# --- Storage (local dev defaults — match docker-compose.yml) ---
# Non-default ports: this host may already run another project's Qdrant/Postgres
# on the standard ports (6333/5432). Dedicated ports keep FinVault's data plane
# isolated rather than sharing infra across projects.
QDRANT_URL=http://localhost:6350
QDRANT_COLLECTION=finvault_chunks
# Empty for the local docker-compose Qdrant, which has no auth. Required by
# Qdrant Cloud, whose URL looks like https://<cluster>.cloud.qdrant.io:6333
QDRANT_API_KEY=

POSTGRES_DSN=postgresql://finvault:finvault_dev_only@localhost:5433/finvault

# --- Security ---
# Path to the local master key (KEK) file. Generated automatically on first run
# if it doesn't exist. In production, swap LocalKeyProvider for a KMS/Vault-backed
# KeyProvider implementing the same interface (security/encryption.py) — nothing
# else in the codebase needs to change.
FINVAULT_MASTER_KEY_PATH=.secrets/master.key

# Which KeyProvider guards the key-encryption-key: local | gcp_kms
#   local    file at FINVAULT_MASTER_KEY_PATH. Dev and self-hosted default.
#   gcp_kms  Google Cloud KMS (src/finvault/security/kms.py). The KEK never
#            leaves the HSM boundary, IAM authorizes every wrap/unwrap, and
#            key use is recorded in Cloud Audit Logs. Requires the extra:
#              pip install 'finvault[gcpkms]'
# There is deliberately NO fallback between them: a KEK that silently
# changes identity makes every chunk wrapped under the old one
# undecryptable, so a misconfiguration fails startup instead.
FINVAULT_KEY_PROVIDER=local

# Required when FINVAULT_KEY_PROVIDER=gcp_kms. Names the CryptoKey, not a
# version — KMS decrypts with whichever version wrapped a given DEK, so
# rotation needs no re-wrapping of the existing corpus.
# FINVAULT_GCP_KMS_KEY_NAME=projects/<p>/locations/<l>/keyRings/<r>/cryptoKeys/<k>

# Unwrapped-DEK cache. EnvelopeEncryptor wraps one DEK per chunk, so without
# a cache every retrieved chunk is a KMS round trip on every query. The TTL
# is the window in which a decrypt can occur without KMS authorizing it:
# shorten it to tighten revocation, set either value to 0 to disable caching
# and send every unwrap to KMS.
# FINVAULT_KMS_DEK_CACHE_MAX_ENTRIES=2048
# FINVAULT_KMS_DEK_CACHE_TTL_SECONDS=300

# Symmetric secret used to sign JWTs issued by the API. Generate a strong random
# value for any non-local deployment: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
FINVAULT_JWT_SECRET=dev-only-change-me

# --- Embeddings ---
# Runs fully locally by default (sentence-transformers) — no document content is
# ever sent to a third-party embedding API.
FINVAULT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Optional: Hugging Face User Access Token for private or gated models/embeddings
HF_TOKEN=

# --- Externalization policy ---
# Data classification tiers that are allowed to be sent to the LLM at all.
# "restricted" is deliberately excluded by default — see security/access_control.py
FINVAULT_ALLOWED_EXTERNAL_CLASSIFICATIONS=public,internal,confidential

# --- Observability (see src/finvault/observability.py) ---
# Every log line is one JSON object, carrying the request_id that also comes
# back to the caller in the X-Request-ID header and in every error body — so a
# user reporting an error hands you the exact key to find their request. Set to
# "text" for readable console output while developing.
FINVAULT_LOG_FORMAT=json

# DEBUG is safe to run: no log call site in this codebase writes document
# plaintext, decrypted content, or credentials.
FINVAULT_LOG_LEVEL=INFO

# --- Redis cache (see src/finvault/cache.py) ---
# Empty means no Redis: the process falls back to an in-memory cache, which is
# correct but per-replica — so a multi-replica deployment gets a lower hit rate
# AND a rate limit that is effectively (limit x replica count), since the
# counters stop being shared. Never a hard dependency: an unreachable Redis
# degrades performance, never availability.
FINVAULT_REDIS_URL=redis://localhost:6379/0
FINVAULT_REDIS_TIMEOUT_SECONDS=0.25

# Cached answers for POST /query. Short by design — the corpus-generation
# counter already retires an org's answers the moment anything is ingested, so
# this only bounds staleness from changes that counter cannot see.
FINVAULT_ENABLE_QUERY_CACHE=true
FINVAULT_QUERY_CACHE_TTL_SECONDS=300

# Embeddings are a pure function of (model, text), so they cache for far longer.
FINVAULT_ENABLE_EMBEDDING_CACHE=true
FINVAULT_EMBEDDING_CACHE_TTL_SECONDS=604800

# --- Rate limiting (see src/finvault/api/rate_limit.py) ---
# One /query fans out into several LLM calls, so this protects provider spend
# and upstream quota, not just CPU.
FINVAULT_ENABLE_RATE_LIMIT=true
FINVAULT_RATE_LIMIT_PER_MINUTE=20
FINVAULT_RATE_LIMIT_PER_HOUR=200
FINVAULT_RATE_LIMIT_ANONYMOUS_PER_MINUTE=10

# --- Metrics (see src/finvault/metrics.py) ---
# GET /metrics is unauthenticated by design and exposes counters and latencies,
# never document content or identity. Restrict it at the network layer.
FINVAULT_ENABLE_METRICS=true

# Per-million-token rates for the configured model, used to turn token counters
# into a spend metric. Zero renders a flat cost panel — the honest signal for
# "not configured", which beats a guessed rate on a cost dashboard.
FINVAULT_PRICE_INPUT_PER_MILLION=0.0
FINVAULT_PRICE_OUTPUT_PER_MILLION=0.0

# --- Row Level Security (see src/finvault/security/rls.py) ---
# Tenant isolation enforced by Postgres rather than by every WHERE clause.
# Off by default because enabling it changes what queries return: any code path
# that reads a tenant table without an org in context sees zero rows.
#
# Two things must be true for it to actually enforce anything, and both fail
# silently if they are not:
#   1. Connect as a NON-SUPERUSER role without BYPASSRLS. The `finvault`
#      account created by POSTGRES_USER is a superuser and ignores every
#      policy. Use `finvault_app` (deploy/postgres/01-app-role.sql).
#   2. That role must not own the tables, so schema creation belongs to a
#      separate migration run as the owner — hence FINVAULT_AUTO_CREATE_SCHEMA.
FINVAULT_ENABLE_RLS=false
FINVAULT_AUTO_CREATE_SCHEMA=true

# To run locally WITH row-level security, swap the DSN above for the app role
# and set the two flags accordingly:
#   POSTGRES_DSN=postgresql://finvault_app:finvault_app_dev_only@localhost:5433/finvault
#   FINVAULT_ENABLE_RLS=true
#   FINVAULT_AUTO_CREATE_SCHEMA=false
