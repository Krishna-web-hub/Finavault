# FinVault Multi-Agent Enterprise AI - Streamlit Secrets Template
# Copy this content into your Streamlit Cloud "Secrets" settings (or .streamlit/secrets.toml for local dev)

# --- LLM Route & Model ---
FINVAULT_LLM_ROUTE = "openrouter"
OPENROUTER_API_KEY = "sk-or-v1-your-openrouter-key-here"
FINVAULT_MODEL = "minimax/minimax-m2.7:free"

# --- Optional Moonshot/Kimi direct route ---
# FINVAULT_LLM_ROUTE = "moonshot"
# KIMI_API_KEY = "your-kimi-key-here"
# FINVAULT_MODEL = "kimi-k3"

# --- Storage / Database ---
# For production (Postgres + Qdrant Cloud):
# POSTGRES_DSN = "postgresql://user:password@host:5432/finvault?sslmode=require"
# QDRANT_URL = "https://your-cluster.cloud.qdrant.io:6333"
# QDRANT_COLLECTION = "finvault_chunks"

# --- Security ---
FINVAULT_JWT_SECRET = "dev-secret-change-in-production-12345"
FINVAULT_ALLOWED_EXTERNAL_CLASSIFICATIONS = "public,internal,confidential"
